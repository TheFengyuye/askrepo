# ── DeepSeek LLM（ask 命令必需；去 https://platform.deepseek.com 注册拿 key）──
DEEPSEEK_API_KEY=sk-xxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ── 本地嵌入模型（transformers.js 自动下载，首次运行）──
# 默认 bge-m3（1024 维，约 2.3GB）。轻量替代：
#   Xenova/bge-small-en-v1.5  /  Xenova/bge-small-zh-v1.5（384 维，几十 MB）
EMBEDDING_MODEL=Xenova/bge-m3

# ── HuggingFace 镜像（国内网络可换 https://hf-mirror.com）──
HF_ENDPOINT=https://huggingface.co

# ── 数据目录（仓库克隆 + SQLite 数据库）──
DATA_DIR=./data

# ── 索引护栏 ──
MAX_REPO_MB=200
