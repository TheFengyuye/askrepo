{
  "name": "askrepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AskRepo — ask questions about any GitHub repository in natural language, answers with file-level citations.",
  "scripts": {
    "cli": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "onnxruntime-node@1.24.3": true,
    "esbuild@0.28.2": true
  }
}
